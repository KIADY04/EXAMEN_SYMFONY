{% extends 'base.html.twig' %}

{% block title %}Gestion des Tâches (ToDo){% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Gestion des Tâches (ToDo)</h1>
        <a href="{{ path('app_todo_new') }}" class="btn btn-primary fw-bold">Ajouter une tâche</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Titre</th>
                        <th>Priorité</th>
                        <th>Statut</th>
                        <th>Affecté à</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for todo in todos %}
                    <tr>
                        <td class="ps-3"><strong>{{ todo.title }}</strong></td>
                        
                        <td>
                            {% if todo.priority == 'URGENT' %}
                                <span class="badge bg-danger">Urgent</span>
                            {% elseif todo.priority == 'PAS IMPORTANT' %}
                                <span class="badge bg-warning text-dark">Pas important</span>
                            {% else %}
                                <span class="badge bg-info text-dark">Important mais pas urgentt</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if todo.status == 'A_FAIRE' %}
                                <span class="badge bg-secondary">À faire</span>
                            {% elseif todo.status == 'EN_COURS' %}
                                <span class="badge bg-primary">En cours</span>
                            {% else %}
                                <span class="badge bg-success">Terminé</span>
                            {% endif %}
                        </td>

                        <td>
    {% if todo.assignedTo == 'ROLE_STUDENT' or todo.assignedTo == 'Étudiant' %}
        <span class="badge bg-info text-dark">Étudiant</span>
    {% elseif todo.assignedTo == 'ROLE_DELEGUE' or todo.assignedTo == 'Délégué' %}
        <span class="badge bg-primary text-white">Délégué</span>
    {% elseif todo.assignedTo == 'ROLE_PROFS' or todo.assignedTo == 'Professeur' %}
        <span class="badge bg-danger text-white">Professeur</span>
    {% else %}
        <span class="badge bg-light text-dark border">{{ todo.assignedTo }}</span>
    {% endif %}
</td>

                        <td class="text-end pe-3">
                            <a href="{{ path('app_todo_show', {'id': todo.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
                            <a href="{{ path('app_todo_edit', {'id': todo.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Aucune tâche enregistrée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}